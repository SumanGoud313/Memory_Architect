<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Real Vibrator/VibrationEffect patterns (core/feedback/haptics) - Compose's
         LocalHapticFeedback used elsewhere doesn't need this, but per-event custom waveforms do. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Runtime-requested on Android 13+ (see SettingsScreen's Notifications section) - local
         streak/daily-challenge reminders (core/notifications/) silently no-op without it, never a
         hard requirement for anything else in the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MemoryArchitectApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MemoryArchitect">
        <!-- Google's official AdMob TEST Application ID - always safe, never serves a real ad.
             Swap for the real AdMob App ID before release. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- Disables WorkManager's default androidx.startup auto-initializer - MemoryArchitectApp
             implements Configuration.Provider instead, so WorkManager is built lazily with the
             injected HiltWorkerFactory (see MemoryArchitectApp's doc) rather than the un-injectable
             default factory the auto-initializer would otherwise install first. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MemoryArchitect.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>