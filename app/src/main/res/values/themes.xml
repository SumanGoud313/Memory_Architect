<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Memory Architect is deliberately dark-only ("dark neon glass" visual identity), so this
      forces Theme.Material3.Dark rather than DayNight — the game should look the same
      regardless of the system light/dark setting.
    -->
    <style name="Theme.MemoryArchitect" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_violet</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/neon_cyan</item>
        <item name="colorOnSecondary">@color/bg_deep_space</item>
        <item name="colorSurface">@color/bg_deep_space</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/surface_glass_stroke</item>
        <item name="android:windowBackground">@color/bg_deep_space</item>
        <item name="android:statusBarColor">@color/bg_deep_space</item>
        <item name="android:navigationBarColor">@color/bg_deep_space</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      The native Android 12+ SplashScreen only bridges cold start - it shows a solid background
      (the SplashScreen API has no gradient support) plus the icon below, then hands off to
      MainActivity's Compose content almost immediately. The full "dark blue/black gradient
      background, fade-in, 0.95->1.0 scale, soft glow, ~800ms" experience the game actually shows
      the player is implemented in Compose (see ui/splash/SplashScreen.kt), which is the very first
      thing rendered after this handoff - the two together read as one continuous premium splash,
      not two competing animations (see MainActivity.kt's short, plain native exit fade).
      windowSplashScreenAnimatedIcon references memory_architect_logo.png directly, NOT
      ic_launcher_foreground - this native splash icon is never system-masked the way an adaptive
      launcher icon is (the platform only scales it to fit, never crops it), so the full,
      unmodified, uninset artwork can be used safely here.
    -->
    <style name="Theme.MemoryArchitect.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_deep_space</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/memory_architect_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MemoryArchitect</item>
    </style>

    <!--
      Shared neon glow treatment for hero text (Home title, gameplay score). Centralized so the
      shadow attrs aren't duplicated wherever the glow look is needed.
    -->
    <style name="TextAppearance.MemoryArchitect.GlowTitle" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:shadowColor">#B39D4EFF</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">24</item>
    </style>

</resources>
