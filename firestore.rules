rules_version = '2';

// Firestore Security Rules for Memory Architect's competitive leaderboard system.
// See LEADERBOARD_SETUP.md for how to paste this into the Firebase console (Firestore Database ->
// Rules tab) and why it's required before LeaderboardRepositoryImpl's reads/writes will succeed.
//
// Design principles:
//  - Every player can read the whole leaderboard (it's public, competitive data), but can only
//    ever write their OWN document - enforced by requiring the document id to equal the
//    authenticated request's uid (request.auth.uid), never a client-supplied value.
//  - Every write is a full validated replace (not a partial merge an attacker could use to sneak
//    one field past validation while leaving stale, still-passing values in the rest of the doc) -
//    every field's type AND plausible range is checked on every write.
//  - This is real, meaningful protection (a modified/rooted client, or a raw REST/curl call using
//    a stolen anonymous auth token, cannot write arbitrary scores or overwrite another player's
//    entry) but it is NOT a substitute for the Cloud Function in functions/validateScoreSubmission.ts,
//    which is the only place that can verify a score against the *actual* level seed/scoring
//    formula server-side. Rules alone can bound "is this a plausible number," never "is this the
//    number this specific round should have produced."
service cloud.firestore {
  match /databases/{database}/documents {

    // players/{uid} - the Global Leaderboard's source. See LeaderboardRepositoryImpl.submitGlobalStats.
    match /players/{uid} {
      allow read: if true; // public leaderboard - anyone (including unauthenticated) can read rankings
      allow write: if isOwner(uid) && isValidGlobalStats(request.resource.data);
    }

    // leaderboardDaily/{yyyy-MM-dd}/entries/{uid} and leaderboardWeekly/{yyyy-Www}/entries/{uid}.
    // Period documents themselves (leaderboardDaily/{date}) are never written directly - only
    // their entries subcollection - so no rule is needed for the parent document.
    match /leaderboardDaily/{period}/entries/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidPeriodicEntry(request.resource.data);
    }

    match /leaderboardWeekly/{period}/entries/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidPeriodicEntry(request.resource.data);
    }

    // leaderboardMonthly/{yyyy-MM}/entries/{uid} - same shape/reset mechanism as Daily/Weekly above,
    // keyed by calendar month instead.
    match /leaderboardMonthly/{period}/entries/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidPeriodicEntry(request.resource.data);
    }

    // playerProfiles/{uid} and dailyRewards/{uid} - the real, per-player-scoped counterpart to
    // mock-backend/'s single shared PlayerProfile/dailyReward state (see
    // FirestoreProgressionRemoteSource's doc for why that mattered). Unlike the leaderboard
    // collections above, these are **private** - a player's own XP/coins/streak/reward-cycle state
    // is never something another player should be able to read, only compete on the denormalized
    // public numbers already exposed via players/{uid}. Read access is required (not just write)
    // because FirestoreProgressionRemoteSource reads these documents inside the same Firestore
    // transaction that writes them.
    match /playerProfiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidProfile(request.resource.data);
    }

    match /dailyRewards/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidDailyReward(request.resource.data);
    }

    // returningPlayerGifts/{uid} - the double-claim guard for
    // FirestoreProgressionRemoteSource.claimReturningPlayerGift, deliberately its own doc rather
    // than a field on dailyRewards/{uid} - see that method's doc for why (dailyRewards' own write
    // is a full overwrite, not a merge). Private, same reasoning as dailyRewards above.
    match /returningPlayerGifts/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidReturningPlayerGift(request.resource.data);
    }

    // submissionNonces/{uid}_{nonce} - replay protection for FirestoreProgressionRemoteSource
    // .submitScore. A doc id is minted once per finished round client-side and reused across any
    // retry of *that* round; the transaction that grants XP/coins checks-then-writes this doc
    // atomically (see the class doc), so a duplicated/replayed write can never succeed twice - the
    // second attempt's transaction.set here is still permitted by this rule (same owner, same
    // shape), but the transaction itself already threw before reaching it.
    //
    // allow read is required here, not optional - submitScore's own transaction does
    // transaction.get(nonceRef).exists() as its very first step (the duplicate check this rule's
    // write side is protecting), so without read access that get() itself is denied and the whole
    // transaction fails with PERMISSION_DENIED before ever reaching the write - every score
    // submission would fail, not just genuine replays. `resource == null` covers the common case
    // (first submission of a nonce, nothing to read yet); `resource.data.uid == request.auth.uid`
    // covers a real prior doc, same ownership check every other collection here uses.
    match /submissionNonces/{nonceId} {
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAtEpochMs is int;
    }

    // playerCosmetics/{uid} - the Point Shop's owned/equipped state, written by
    // FirestoreShopRemoteSource.purchase/spin/equip - and, since the real-money Premium Shop grant
    // path stopped calling a Cloud Function, also written directly by
    // core.billing.CosmeticCollectionGrantor (inside the same transaction as the
    // claimedPurchaseTokens write below) for a Premium Collection purchase. Private, same reasoning
    // as playerProfiles above - a player's own cosmetic inventory isn't public leaderboard data.
    match /playerCosmetics/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidCosmetics(request.resource.data);
    }

    // claimedPurchaseTokens/{sha256(purchaseToken)} - the Spark-plan-compatible replay guard for a
    // real-money purchase grant (core.billing.CosmeticCollectionGrantor), replacing what a Cloud
    // Function's own claimedPurchaseTokens check used to do server-side. A document that already
    // exists is evaluated as an `update` by these rules regardless of the client's intent - denying
    // `update` (and `delete`) makes a second claim of the same purchase token fail outright, the
    // same guarantee the removed Cloud Function gave (minus cross-account revocation lookups, which
    // genuinely need a server - see BillingManagerImpl's own doc for that accepted trade-off).
    // `allow read: if false` because nothing legitimate ever needs to read this back - the app only
    // ever attempts a `create`, and a permission-denied on that attempt already tells the client the
    // token was claimed, without needing a separate read.
    match /claimedPurchaseTokens/{tokenHash} {
      allow read: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.claimedAtEpochMs is int;
      allow update, delete: if false;
    }

    // purchaseReceipts/{uid}_{nonce} - replay protection for purchase/spin, direct analog of
    // submissionNonces above - same allow read requirement and reasoning: FirestoreShopRemoteSource
    // .purchase/.spin both do transaction.get(receiptRef).exists() as their first step, so without
    // read access every purchase/spin would fail with PERMISSION_DENIED, not just genuine replays.
    match /purchaseReceipts/{receiptId} {
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sku is string
        && request.resource.data.priceCoins is int && request.resource.data.priceCoins >= 0
        && request.resource.data.kind in ['PURCHASE', 'SPIN']
        && request.resource.data.createdAtEpochMs is int;
    }

    // luckySpinState/{uid} - Lucky Spin's own daily-gate/first-spin state, written by
    // FirestoreShopRemoteSource.spin - deliberately its own document rather than fields on
    // playerProfiles/{uid}, see LuckySpinState.kt's doc. Private, same reasoning as
    // playerCosmetics/playerProfiles above.
    match /luckySpinState/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidLuckySpinState(request.resource.data);
    }

    // inventory/{uid} - the permanent home for earned consumables (Hint/Redo/Rewatch tokens,
    // Lucky Spin tickets, XP boosts, discount coupons, mystery chests), written by
    // FirestoreMissionRemoteSource.claimMissionReward/consumeInventoryItem. Private, same
    // reasoning as playerCosmetics/playerProfiles above.
    match /inventory/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidInventory(request.resource.data);
    }

    // missionClaims/{uid} - one claimedKeys map ("{missionId}_{periodKey}" -> epoch-ms claimed),
    // the double-claim guard for FirestoreMissionRemoteSource.claimMissionReward. No client ever
    // needs to distinguish individual keys, only check membership, so a flat map (rather than a
    // subcollection per claim) keeps this to one read+write per claim, same shape playerCosmetics'
    // ownedSkus uses for an ever-growing, append-only set.
    match /missionClaims/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidMissionClaims(request.resource.data);
    }

    // missionCategoryBonusClaims/{uid} - one claimedKeys map ("{period}_{periodKey}" -> epoch-ms
    // claimed), the double-grant guard for FirestoreMissionRemoteSource.claimCategoryBonus.
    // Deliberately its own document, not a key on missionClaims/{uid} above - see that method's
    // doc for why (a "{period}_..." key would fail missionClaims' own MissionId-shaped validation).
    match /missionCategoryBonusClaims/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidMissionCategoryBonusClaims(request.resource.data);
    }

    // missionRefreshState/{uid} - the "pay 1000 coins to skip the countdown" override, written by
    // FirestoreMissionRemoteSource.unlockAllMissionsEarly. Private, same reasoning as
    // playerCosmetics/playerProfiles above.
    match /missionRefreshState/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidMissionRefreshState(request.resource.data);
    }

    // Everything else is denied by default (Firestore's implicit deny-all for any path with no
    // matching rule) - no catch-all "allow" rule exists anywhere in this file on purpose.

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidGlobalStats(data) {
      return data.displayName is string && data.displayName.size() <= 32
        && data.highestLevel is int && data.highestLevel >= 1 && data.highestLevel <= 100
        && data.totalStars is int && data.totalStars >= 0 && data.totalStars <= 300
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 5000 // one round's worth (a running max), not a lifetime total - mirrors isValidPeriodicEntry's own score bound
        && data.perfectLevels is int && data.perfectLevels >= 0
        && data.averageAccuracy is number && data.averageAccuracy >= 0 && data.averageAccuracy <= 1
        && data.averageCompletionTimeMs is int && data.averageCompletionTimeMs >= 0
        && data.totalObjectsMemorized is int && data.totalObjectsMemorized >= 0
        && data.totalLevelsCompleted is int && data.totalLevelsCompleted >= 0
        && data.totalPlayTimeMs is int && data.totalPlayTimeMs >= 0
        && data.winStreak is int && data.winStreak >= 0
        && data.longestWinStreak is int && data.longestWinStreak >= 0
        && data.achievementCount is int && data.achievementCount >= 0
        && data.updatedAtEpochMs is int
        && isValidIdentityFields(data);
    }

    function isValidPeriodicEntry(data) {
      return data.displayName is string && data.displayName.size() <= 32
        && data.score is int && data.score >= 0 && data.score <= 5000 // one round's worth, not a lifetime total
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 1
        && data.completionTimeMs is int && data.completionTimeMs >= 0 && data.completionTimeMs <= 1800000
        && data.isPerfectRun is bool
        && data.submittedAtEpochMs is int
        && isValidIdentityFields(data);
    }

    // avatarId/avatarUrl/country/verified/league - denormalized onto every leaderboard doc
    // (players/{uid} and every periodic entry) by LeaderboardRepositoryImpl.currentIdentityFields.
    // Mirrors AvatarCatalog.kt's curated id set and League.kt's enum names - keep both in sync if
    // either changes, the same "mirrors X" convention already used elsewhere in this file/functions.
    function isValidIdentityFields(data) {
      return data.avatarId is string
        && data.avatarId in ['architect_gold', 'compass', 'hourglass', 'key', 'lantern', 'crystal',
                              'owl', 'fox', 'dragon', 'phoenix', 'star', 'moon', 'comet', 'shield']
        && (data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (data.country == null || (data.country is string && data.country.size() == 2))
        && data.verified is bool
        && data.league is string
        && data.league in ['APPRENTICE', 'JOURNEYMAN', 'ARCHITECT', 'MASTER_ARCHITECT', 'GRANDMASTER'];
    }

    // Mirrors PlayerProfile.kt's own field shape - see FirestoreProgressionRemoteSource.
    // updatedAtEpochMs is bounded against request.time (the *server's* clock, not the device's -
    // the one part of this check a modified client can't lie about) so a captured-and-replayed
    // write more than 10 minutes stale is rejected here before the submissionNonces check even
    // runs - defense in depth alongside the nonce, not a replacement for it (the nonce is exact and
    // permanent; this only bounds how old a *first-time* replay of a captured payload can be).
    function isValidProfile(data) {
      return data.xp is int && data.xp >= 0 && data.xp <= 1000000000
        && data.coins is int && data.coins >= 0 && data.coins <= 1000000000
        && data.currentStreak is int && data.currentStreak >= 0
        && data.longestStreak is int && data.longestStreak >= 0
        // Mirrors StreakRules.Default.maxStoredShields (domain/model/StreakRules.kt) - keep both
        // in sync. Bounds shape/range only; validateProfileWrite in functions/src/index.ts is what
        // actually checks this only ever moves by the one shield a single write can plausibly
        // grant or consume, the same division of labor as xp/coins above.
        && data.streakShields is int && data.streakShields >= 0 && data.streakShields <= 3
        && (data.lastPlayedEpochDay == null || data.lastPlayedEpochDay is int)
        && (data.dailyChallengeWonAtEpochSecond == null || data.dailyChallengeWonAtEpochSecond is int)
        && (data.weeklyChallengeWonAtEpochSecond == null || data.weeklyChallengeWonAtEpochSecond is int)
        // Mirrors MemoryJourneyCatalog.kt's top tier threshold with generous headroom - bounds
        // shape/range only, same division of labor as streakShields above (validateProfileWrite
        // is what checks this only ever moves by one plausible write's worth of points).
        && data.journeyPoints is int && data.journeyPoints >= 0 && data.journeyPoints <= 1000000000
        && data.updatedAtEpochMs is int
        && data.updatedAtEpochMs > request.time.toMillis() - 600000
        && data.updatedAtEpochMs < request.time.toMillis() + 600000
        // Optional - which client operation caused this write, so validateProfileWrite in
        // functions/src/index.ts can rate-limit each independently instead of one shared bucket
        // (see that file's PROFILE_WRITE_SOURCES). Shape/length bound only, same division of
        // labor as everywhere else in this function - the Function is what checks the value
        // itself is one of the known sources.
        && (data.lastWriteSource == null || (data.lastWriteSource is string && data.lastWriteSource.size() <= 40));
    }

    // Mirrors DailyRewardCatalog.kt - cycleDay is always 1..7 (the reward table's length).
    function isValidDailyReward(data) {
      return data.cycleDay is int && data.cycleDay >= 1 && data.cycleDay <= 7
        && (data.lastClaimedEpochDay == null || data.lastClaimedEpochDay is int);
    }

    // Shape/size bounds only - the actual "owned set only grows, no unknown skus, equipped
    // references only owned skus" invariants need to compare against the *previous* document,
    // which rules can't cheaply do here (no access to a fetched prior-doc without an extra get()
    // per write) - that's exactly what functions/src/index.ts's validateCosmeticsWrite re-checks
    // immediately after, same division of labor as isValidProfile/validateProfileWrite above.
    function isValidCosmetics(data) {
      return data.ownedSkus is list && data.ownedSkus.size() <= 200
        && data.equipped is map && data.equipped.size() <= 20
        && data.updatedAtEpochMs is int;
    }

    // Shape/size bounds only - the actual "quantities only change by a plausible per-write amount"
    // invariant needs the previous document, same division of labor as isValidProfile/
    // validateProfileWrite: functions/src/missions.ts's validateInventoryWrite re-checks that.
    function isValidInventory(data) {
      return data.quantities is map && data.quantities.size() <= 20
        && data.updatedAtEpochMs is int;
    }

    // No numeric bounds needed on the map's values (they're epoch-ms timestamps, not economy
    // values) - just a sane cap on how many distinct claims one player can accumulate.
    function isValidMissionClaims(data) {
      return data.claimedKeys is map && data.claimedKeys.size() <= 1000;
    }

    // Same shape as isValidMissionClaims above - the actual "was every active mission in this
    // period really claimed" eligibility check needs missionClaims/{uid} itself, which
    // functions/src/index.ts's validateMissionCategoryBonusClaims re-derives, same division of
    // labor as isValidProfile/validateProfileWrite.
    function isValidMissionCategoryBonusClaims(data) {
      return data.claimedKeys is map && data.claimedKeys.size() <= 200;
    }

    // Three epoch-day-or-null integers - no economy bounds needed here (this only ever gates which
    // mission set shows, never a coin/item amount directly); functions/src/index.ts's
    // validateMissionRefreshState checks each field only ever moves forward, never backward.
    function isValidMissionRefreshState(data) {
      return (data.dailyForcedPeriodKey == null || data.dailyForcedPeriodKey is int)
        && (data.weeklyForcedPeriodKey == null || data.weeklyForcedPeriodKey is int)
        && (data.monthlyForcedPeriodKey == null || data.monthlyForcedPeriodKey is int);
    }

    // One epoch-day integer, no bounds needed beyond the type check - the actual "is this gap
    // really long enough, has today's gift already been claimed" eligibility needs the player's
    // own playerProfiles/{uid} doc, which functions/src/index.ts's validateReturningPlayerGiftWrite
    // re-checks, same division of labor as isValidProfile/validateProfileWrite above.
    function isValidReturningPlayerGift(data) {
      return data.lastClaimedOnEpochDay is int;
    }

    // Two epoch-day-or-null integers plus a bool - no economy bounds needed (these gate spin
    // *frequency*, not coin amounts; the actual per-write coin-gain cap is enforced on
    // playerProfiles/{uid} by validateProfileWrite regardless of which allowance a spin used), same
    // "shape/type only" division of labor isValidInventory already uses.
    function isValidLuckySpinState(data) {
      return (data.lastFreeSpinEpochDay == null || data.lastFreeSpinEpochDay is int)
        && (data.lastAdSpinEpochDay == null || data.lastAdSpinEpochDay is int)
        && data.hasEverSpun is bool;
    }
  }
}
